{
  "compilerOptions": {
    "target": "ES2022",                       // Set the target JavaScript version
    "module": "Node16",                  // Module system to use (CommonJS for Node.js)
    "moduleResolution": "node16",
    "esModuleInterop": true,               // Enable interoperability between CommonJS and ES modules
    "strict": true,                        // Enable all strict type-checking options
    "skipLibCheck": true,                  // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true,  // Ensure consistent casing for file names
    "outDir": "./dist",                    // Output directory for compiled JavaScript files
    "rootDir": "./src",                    // Root directory of your TypeScript files
    "resolveJsonModule": true              // Allow importing JSON files as modules
  },
  "include": [
    "src/**/*.ts"                          // Include all TypeScript files in the src folder
  ],
  "exclude": [
    "node_modules"                         // Exclude node_modules from compilation
  ]
}